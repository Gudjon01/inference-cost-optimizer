# Copy to deploy/.env and fill in. Compose reads it automatically.

# Bearer token for the gateway's admin API (drain, undrain). Any long random string.
ICO_ADMIN_TOKEN=

# Password for the ClickHouse user "ico". Any long random string.
ICO_CLICKHOUSE_PASSWORD=

# Config file to mount. Defaults to ./config.yaml.
# ICO_CONFIG_FILE=./config.mock.yaml

# Version of ico's images, ghcr.io/gudjon01/ico-gateway and ico-collector.
# Defaults to the release this checkout came with; images exist from 0.1.1.
# ICO_VERSION=0.1.1

# Only for the "vllm" profile.
# ICO_VLLM_IMAGE=vllm/vllm-openai:v0.31.0
# ICO_VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# Engine flags. Replaces the default, which is the tracing flag below: drop it
# only for an image without OpenTelemetry (vLLM builds before it was bundled).
# ICO_VLLM_ARGS="--otlp-traces-endpoint grpc://collector:4317 --gpu-memory-utilization 0.6 --max-model-len 4096"
# ICO_VLLM_REPLICA=r1
# HF_TOKEN=
# HF_HUB_OFFLINE=1   # serve only models already in the Hugging Face cache
